@page "/quran"
@using global::Quran.Data
@rendermode InteractiveServer

<PageTitle>Quran Chapters</PageTitle>

<div class="container py-4">
    <div class="row align-items-center mb-4">
        <div class="col-lg-8">
            <h1 class="display-6 fw-bold">Quran</h1>
            <p class="lead mb-0">Browse the chapters of the Quran with the Zulu & English translations, meanings, and selected verses.</p><br/>
        </div>
        <div class="col-lg-4">
            <div class="d-flex gap-2">
                <input class="form-control" placeholder="surah or verse" @bind="searchText" @bind:event="oninput" @onkeydown="HandleKeyDown" />
                <button class="btn btn-success" @onclick="SearchSurahs">Search</button>
                <button class="btn btn-outline-secondary" @onclick="ClearSearch">Clear</button>
            </div>
        </div>
    </div>

    @* <div class="d-flex flex-wrap gap-2 mb-4">
        <button class="btn btn-primary" @onclick="() => SelectSurah(1)">Read Al-Fatiha</button>
        <button class="btn btn-outline-primary" @onclick="() => SelectSurah(114)">Read An-Nas</button>
    </div> *@

    @if (!string.IsNullOrWhiteSpace(activeSearchText))
    {
        <p class="text-muted mb-3">Showing results for <strong>@activeSearchText</strong>.</p>
    }

    @if (!FilteredSurahs.Any())
    {
        <div class="alert alert-warning" role="alert">
            No surahs matched your search. Try another keyword or clear the filter.
        </div>
    }

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var surah in FilteredSurahs)
        {
            var hasVerses = surah.Verses.Count > 0;
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="card-title mb-1">@surah.Number. @surah.EnglishName</h5>
                                <p class="text-muted mb-2"><strong> @surah.ArabicName</strong> </p>
                            </div>
                            <span class="badge bg-success rounded-pill"> @surah.Meaning</span>
                        </div>
                        <p class="mb-2"><strong> @surah.Translation </strong></p>
                        @if (hasVerses)
                        {
                            <div class="mt-3">
                                <button class="btn btn-outline-success btn-sm" @onclick="() => SelectSurah(surah.Number)">Read verses</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (selectedSurah is not null && selectedSurah.Verses.Count > 0)
    {
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <h3 class="h5 fw-bold mb-1">@selectedSurah.Number. @selectedSurah.EnglishName</h3>
                        <p class="text-muted mb-0">@selectedSurah.ArabicName · @selectedSurah.Translation</p>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CloseSelectedSurah">Close</button>
                </div>

                @foreach (var verse in selectedSurah.Verses)
                {
                    <div class="border-top pt-3 mt-3">
                        <p class="fw-bold mb-2">@verse.Number.</p>
                        <p class="mb-2 fs-5">@verse.ArabicText</p>
                        <p class="mb-1 text-muted"><em>@verse.Transliteration</em></p>
                        <p class="mb-0" style="color: green;">@verse.Translation</p>
                        <p class="mb-0">@verse.Zulu</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private string searchText = string.Empty;
    private string activeSearchText = string.Empty;
    private readonly SurahService surahService = new();
    private Surah? selectedSurah;

    private IEnumerable<Surah> FilteredSurahs =>
        surahService.GetAllSurahs()
            .Where(s => MatchesSearch(s, activeSearchText));

    private void SearchSurahs()
    {
        activeSearchText = searchText.Trim();
    }

    private void ClearSearch()
    {
        searchText = string.Empty;
        activeSearchText = string.Empty;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SearchSurahs();
        }
    }

    private void SelectSurah(int number)
    {
        var surah = surahService.GetSurahByNumber(number);
        if (surah is not null)
        {
            selectedSurah = surah;
        }
    }

    private void CloseSelectedSurah()
    {
        selectedSurah = null;
    }

    private static bool MatchesSearch(Surah surah, string searchText)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return true;
        }

        var query = searchText.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        return surah.Number.ToString().Contains(query, StringComparison.OrdinalIgnoreCase)
            || surah.EnglishName.Contains(query, StringComparison.OrdinalIgnoreCase)
            || surah.ArabicName.Contains(query, StringComparison.OrdinalIgnoreCase)
            || surah.Translation.Contains(query, StringComparison.OrdinalIgnoreCase)
            || surah.Meaning.Contains(query, StringComparison.OrdinalIgnoreCase)
            || surah.Transliteration?.Contains(query, StringComparison.OrdinalIgnoreCase) == true
            || surah.Verses.Any(v => v.Translation.Contains(query, StringComparison.OrdinalIgnoreCase)
                || v.ArabicText.Contains(query, StringComparison.OrdinalIgnoreCase)
                || v.Transliteration.Contains(query, StringComparison.OrdinalIgnoreCase));
    }
}
