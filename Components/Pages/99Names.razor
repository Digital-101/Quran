@page "/names"

<PageTitle>99 Names of Allah</PageTitle>

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h2 class="display-6 fw-bold">99 Names of Allah</h2>
            <p class="lead mb-0">A reference list in Arabic, transliteration, Zulu, and English.</p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">No.</th>
                    <th scope="col">Arabic</th>
                    <th scope="col">Zulu</th>
                    <th scope="col">English</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Names.Count; i++)
                {
                    var name = Names[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td lang="ar">@name.Arabic <span class="text-muted small">(@name.Transliteration)</span></td>
                        <td>@name.Zulu</td>
                        <td>@name.English</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

